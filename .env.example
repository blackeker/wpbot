# AI Davranış Ayarları
AI_AUTO_REPLY_DM=true
AI_AUTO_REPLY_MENTION=true

# VDS IP / Web İndirme ve Canlı İzleme Adresi
# VDS_IP=111.235.150.157

# Proxy Ayarı (Gerekirse)
# PROXY_URL=http://kullanici:sifre@ip:port

# Otomatik Disk ve Önbellek Temizleme Ayarları
