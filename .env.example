# WhatsApp Bot Ayarları
WHATSAPP_PHONE_NUMBER=905551234567
PORT=7860
BOT_NAME=Kondi AI
OWNER_NUMBER=905551234567

# 🤖 Yapay Zeka Sağlayıcıları (Sıralı Fallback / Yedekleme Havuzu)
# 1. Tercih (Primary): Groq Cloud (https://console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Tercih (Secondary): OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...
